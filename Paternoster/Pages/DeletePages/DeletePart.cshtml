@page
@model DeletePartModel

@{
    ViewData["Title"] = "Delete";
}

<h3>Weet je zeker dat je "@Model.Part.Name" wil verwijderen?</h3>
<div>
    <p>
        Houd er rekening mee dat door dit onderdeel te verwijderen,<br />
        dit onderdeeel wordt verwijderd uit ieder product dat dit onderdeel gebruikt!
    </p>


    <div class="delete-buttons">
        <form method="post">
            <input type="hidden" asp-for="Part.Id" />
            <input class ="delete-button" type="submit" value="Verwijder" />
        </form>
        <a class="return-button" asp-page="/FigurinePart">Nee, keer terug</a>
    </div>


</div>
