@page
@using Paternoster.Models
@model ProductsModel
@{
    ViewData["Title"] = "Producten";
}
<h1>Zoek een product:</h1>
<div class="container">
    <form method="get">
        <label for="Name"> Naam van het Product:</label>
        <input name="Name" />
        <input type="submit" value="&#x1F50D;" />

        <label for="orderByName">Sorteer op alfabetische volgorde.</label>
        <input type="checkbox" name="orderByName" id="true" />

        <label for="affiliation">Filter op groep:</label>
        <select name="affiliation" default ="">
            <option value="">-----</option>
            @foreach(string affiliation in Model.Affiliations)
                {
                    <option value="@affiliation">@affiliation</option>
                }
            </select>

        <input class="btn btn-primary" type="submit" value="zoek" />
    </form>
</div>

<div>
    @if (Model.Products == null)
    {
        <h2>Sorry, maar ik heb geen producten gevonden. Probeer een nieuwe zoekopdracht.</h2>
    }
    else
    {
        foreach (Product product in Model.Products)
        {
            <div class="product-container">
                <div class="info-container">
                    <div class="product-header">
                        <h3>Naam:</h3>
                        <p>@product.Name</p>
                    </div>
                    <div class="product-header">
                        <h3>Code:</h3>
                        <p>@product.ProductCode</p>
                    </div>
                    <div class="product-info">
                        <h3>Onderdelen</h3>
                        <ul class="parts-list">
                            @foreach(ProductPart part in product.ProductParts)
                            {
                                <li>@part.PartAmount x @part.Part.Name</li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="image-container">
                    @if (product.ImageReference != null)
                    {
                        <img src="/Images/ProductImages/@product.ImageReference" class="product-image">
                    }
                    else
                    {
                        <img src="/Images/ProductImages/Placeholder.jpg" class="product-image">
                    }
                </div>
            </div>
        }
    }
</div>

