@page
@using Paternoster.Models
@model ProductsModel
@{
    ViewData["Title"] = "Producten";
}
<h1>Zoek een product:</h1>
<fieldset class="searchbar">
    <form method="get">
        <label for="Name"> Naam van het Product:</label>
        <input name="Name" />
        <input type="submit" value="&#x1F50D;" />

        <label for="orderByName">Sorteer op alfabetische volgorde.</label>
        <input type="checkbox" name="orderByName" id="true" />

        <label for="affiliation">Filter op groep:</label>
        <select name="affiliation" default ="">
            <option value="">-----</option>
            @foreach(string affiliation in Model.Affiliations)
                {
                    <option value="@affiliation">@affiliation</option>
                }
            </select>

        <input class="btn btn-primary" type="submit" value="zoek" />
    </form>
</fieldset>

<div class="Products-Grid">
    @if (Model.Products == null)
    {
        <h2>Sorry, maar ik heb geen producten gevonden. Probeer een nieuwe zoekopdracht.</h2>
    }
    else
    {
        foreach (Product product in Model.Products)
        {
            string imageFileName = product.ProductCode + ".jpg";
            string imageFileLocation = System.IO.Path.Combine(@Model._environment.WebRootPath, "Images", "ProductImages", imageFileName);
            <div class="Product-Container">

                <div class="Product-Image-Container">
                    @if(System.IO.File.Exists(imageFileLocation))
                    {
                        <img class="Product-Image" src="/Images/ProductImages/@imageFileName">
                    }
                    else
                    {
                        <img class="Product-Image" src="/Images/ProductImages/Placeholder.jpg">
                    }
                </div>

                <div class="Product-Info-Container">
                    <div class="Product-Header">
                        <h3>Naam:</h3>
                        <p>@product.Name</p>
                    </div>
                    <div class="Product-Header">
                        <h3>Code:</h3>
                        <p>@product.ProductCode</p>
                    </div>
                    <div class="Product-Parts-Info">
                        <h3>Onderdelen</h3>
                        <ul class="parts-list">
                            @foreach(ProductPart part in product.ProductParts)
                            {
                                <li>@part.PartAmount x @part.Part.Name</li>
                            }
                        </ul>
                    </div>
                </div>
                <div class="Product-Header">
                    <a class="btn btn-primary" asp-route-id="@product.Id" asp-page="/EditPages/EditProduct">&#128393</a>
                </div>

            </div>
        }
    }
</div>

