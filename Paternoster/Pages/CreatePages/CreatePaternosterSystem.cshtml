@page
@model CreatePaternosterSystemModel
@using Paternoster.Models;

@{
    ViewData["Title"] = "Create";
}

<h1>Formulier voor het aanmaken van een nieuw paternostersysteem.</h1>
<h4>Vul alstublieft zo veel mogelijk gegevens in. Invoervelden met een * zijn verplicht.</h4>
<hr />
<fieldset class="Create-Form">
    <div class="Form-Fields">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="PaternosterSystem.Name" class="control-label">Welke naam heeft dit paternostersysteem?</label>
                <input asp-for="PaternosterSystem.Name" class="form-control" aria-required="true"/>
                <span asp-validation-for="PaternosterSystem.Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Paternostersysteem aanmaken" class="btn btn-primary" />
            </div>
        </form>
    </div>
</fieldset>

<div>
    <a class="btn btn-primary" asp-area="" asp-page="/Create">Terug naar Creatie-scherm</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
