@page
@model CreatePartModel
@using Paternoster.Models
@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Part</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Part.Name" class="control-label">Hoe heet dit onderdeel?</label>
                <input asp-for="Part.Name" class="form-control" aria-required="true"/>
                <span asp-validation-for="Part.Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Part.PartCode" class="control-label">Welke code heeft dit onderdeel?</label>
                <input asp-for="Part.PartCode" class="form-control" aria-required="true"/>
                <span asp-validation-for="Part.PartCode" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Part.ContainerId" class="control-label">In welke container gaat dit onderdeel?</label>
                <select asp-for="Part.ContainerId" class="form-control">
                    <option value="">---Selecteer Container---</option>
                    @foreach (PaternosterContainer paternosterContainer in Model.PaternosterContainers)
                    {
                        <option value="@paternosterContainer.Id">@paternosterContainer.ContainerCode</option>
                    }
                </select>
                <span asp-validation-for="Part.ContainerId" class="text-danger"></span>
            </div>

            <div>
                <a class="btn btn-primary" asp-area="" asp-page="./CreatePaternosterContainer">PaternosterContainer Toevoegen</a>
            </div>

            <div class="form-group">
                <label asp-for="Part.ImageReference" class="control-label"></label>
                <input asp-for="Part.ImageReference" class="form-control" />
                <span asp-validation-for="Part.ImageReference" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a class="btn btn-primary" asp-area="" asp-page="/Create">Terug naar Creatie-scherm</a>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
