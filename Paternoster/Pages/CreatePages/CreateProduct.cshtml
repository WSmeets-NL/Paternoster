@page
@model CreateProductModel
@using Paternoster.Models

@{
    ViewData["Title"] = "Create";
}

<h1>Formulier voor het aanmaken van een nieuw product.</h1>
<h4>Vul alstublieft zo veel mogelijk gegevens in. Invoervelden met een * zijn verplicht.</h4>
<hr />
<div class="row">
    <div class="Form-Fields">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Product.ProductCode" class="control-label">Welke code heeft dit product?</label>
                <input asp-for="Product.ProductCode" class="form-control" aria-required="true"/>
                <span asp-validation-for="Product.ProductCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Product.Name" class="control-label">Wat is de naam van dit product?</label>
                <input asp-for="Product.Name" class="form-control" aria-required="true"/>
                <span asp-validation-for="Product.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Product.Affiliation" class="control-label">Tot welke groep/factie behoort dit product?</label>
                <input asp-for="Product.Affiliation" class="form-control" />
                <span asp-validation-for="Product.Affiliation" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Product.ProductImage" class="control-label">Voeg een afbeelding toe:</label>
                <input type="file" asp-for="Product.ProductImage" class="form-control" />
                <span asp-validation-for="Product.ProductImage" class="text-danger"></span>
            </div>
            
            <div class="add-parts">
                <label class="control-label">Voeg onderdelen toe:</label>

                <div id="part-template">
                    <input type="hidden" id="total" value="1"/>
                    <button class="btn btn-primary add-part" type="button">onderdeel toevoegen</button>
                    <div class="part-row">
                        <select name="ChosenParts[0].PartId" class="part-select">
                            <option value="">---nieuw onderdeel---</option>
                            @foreach (var part in Model.AvailableParts)
                            {
                                <option value="@part.Id">@part.Name</option>
                            }
                        </select>
                        <button type="button" class="remove-part btn btn-primary">Verwijderen</button>
                    </div>
                </div>

                <div id="parts-container"></div>

            </div>
            <div class="form-group">
                <input type="submit" value="Product Aanmaken" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a class="btn btn-primary" asp-area="" asp-page="/Create">Terug naar Creatie-scherm</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        $(".add-part").click(function () {

            var rowCount = parseInt($("#total").val());
            $("#total").val(rowCount + 1);

            // Clone template
            var newRow = $("#part-template .part-row").clone();

            // Index correct zetten voor modelbinding
            newRow.find("select").attr("name", "ChosenParts[" + rowCount + "].PartId");

            $("#parts-container").append(newRow);
        });

        // Dynamisch verwijderbare rijen
        $(document).on("click", ".remove-part", function () {
            $(this).closest(".part-row").remove();
        });
    </script>  
}

