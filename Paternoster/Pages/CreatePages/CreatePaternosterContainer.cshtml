@page
@model CreatePaternosterContainerModel
@using Paternoster.Models
@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>PaternosterContainer</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="PaternosterContainer.ContainerCode" class="control-label">Welke code krijgt je container?</label>
                <input asp-for="PaternosterContainer.ContainerCode" class="form-control" aria-required="true"/>
                <span asp-validation-for="PaternosterContainer.ContainerCode" class="text-danger"></span>
            </div>


            <div class="form-group">
                <label asp-for="PaternosterContainer.PaternosterId" class="control-label">Aan welke paternoster wil je een container toevoegen?</label>
                <select asp-for="PaternosterContainer.PaternosterId" class="form-control" aria-required="true">
                    <option value="">---Kies een paternoster---</option>
                    @foreach (Paternoster paternoster in Model.Paternosters)
                            {
                        <option value="@paternoster.Id">@paternoster.PaternosterCode</option>
                            }
                        </select>
                <span asp-validation-for="PaternosterContainer.PaternosterId" class="text-danger"></span>

                <a class="btn btn-primary" asp-area="" asp-page="./CreatePaternosterSystem">Paternoster Toevoegen</a>
            </div>
            <hr />git
            <div class="form-group">
                <input type="submit" value="Maak nieuwe container" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<hr />
<div>
    <a class="btn btn-primary" asp-area="" asp-page="/Create">Terug naar Creatie-scherm</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
