@page
@model CreatePaternosterModel;
@using Paternoster.Models

@{
    ViewData["Title"] = "Create";
}

<h1>Formulier voor het aanmaken van een nieuwe paternoster.</h1>
<h4>Vul alstublieft zo veel mogelijk gegevens in. Invoervelden met een * zijn verplicht.</h4>
<hr />
<fieldset class="Create-Form">
    <div class="Form-Fields">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Paternoster.PaternosterCode" class="control-label">PaternosterCode</label>
                <input asp-for="Paternoster.PaternosterCode" class="form-control" aria-required="true"/>
                <span asp-validation-for="Paternoster.PaternosterCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Paternoster.PaternosterSystemId" class="control-label">Kies een Paternostersysteem</label>
                <select asp-for="Paternoster.PaternosterSystemId" class="form-control" aria-required="true">
                    <option value="">---Selecteer Paternostersysteem---</option>
                    @foreach(PaternosterSystem paternosterSystem in Model.PaternosterSystems)
                    {
                       <option value="@paternosterSystem.Id">@paternosterSystem.Name</option>
                    }
                </select>
                <span asp-validation-for="Paternoster.PaternosterSystemId" class="text-danger"></span>

                <a class="btn btn-primary" asp-area="" asp-page="./CreatePaternosterSystem">Paternostersysteem Toevoegen</a>
            </div>

            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Paternoster.NumberOfContainers" class="control-label">Hoeveel containers heeft deze paternoster?</label>
                <input asp-for="Paternoster.NumberOfContainers" class="form-control" aria-required="true"/>
                <span asp-validation-for="Paternoster.NumberOfContainers" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Paternoster.Location" class="control-label">In welke ruimte staat de paternoster</label>
                <input asp-for="Paternoster.Location" class="form-control" placeholder="room 000"/>
                <span asp-validation-for="Paternoster.Location" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Paternoster Aanmaken" class="btn btn-primary" />
            </div>
        </form>
    </div>
</fieldset>

<div>
    <a class="btn btn-primary" asp-area="" asp-page="/Create">Terug naar Creatie-scherm</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
