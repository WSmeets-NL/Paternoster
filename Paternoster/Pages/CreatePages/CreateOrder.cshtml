@page
@model CreateOrderModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Order</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Order.OrderCode" class="control-label"></label>
                <input asp-for="Order.OrderCode" class="form-control" aria-required="true"/>
                <span asp-validation-for="Order.OrderCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Order.OrderLines" class="control-label"></label>
                <input asp-for="Order.OrderLines" class="form-control" />
                <span asp-validation-for="Order.OrderLines" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Order.Customer" class="control-label"></label>
                <select asp-for="Order.Customer" class="form-control" aria-required="true">
                    @foreach(Customer customer in Model.Customer)
                </select>"
                <span asp-validation-for="Order.Customer" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
