@page
@using Paternoster.Models
@model FigurinePartModel
@{
    ViewData["Title"] = "FigurinePart";
}
<h1>Zoek een onderdeel:</h1>
<fieldset class="searchbar>"
    <form method="get">

        <label for="name"> Naam van het onderdeel:</label>
        <input name="Name" />
        <label for="productId">Wordt gebruikt in:</label>
        <select name="productId">
            <option value="">-----</option>
            @foreach(Product product in Model.Products)
                {
                    <option value="@product.Id">@product.Name</option>
                }
            </select>
        <input type="submit" value="&#x1F50D;" />

     </form>
</fieldset>

<div class="Parts-Grid">
    @if(Model.Parts != null)
    {
        foreach (Part part in Model.Parts)
        {
        <div class="Part-Container">
            <div class="Part-Image-Container">
                @if (part.PartImage != null)
                {
                    <img class="Part-Image" src="/Images/PartImages/@part.PartCode">
                }
                else
                {
                    <img class="Part-Image" src="/Images/PartImages/Placeholder.jpg">
                }
            </div>

            <div class="Part-Info-Container">
                <div class="Part-Header">
                    <h4>Naam:</h4>
                    <p>@part.Name</p>
                </div>

                <div class="Part-Header">
                    <h4>Code:</h4>
                    <p>@part.PartCode</p>
                </div>

                <div class="Part-Header">
                    <h4>Paternoster : Container</h4>
                    <p>@part.Container.Paternoster.PaternosterCode : @part.Container.ContainerCode</p>
                </div>

                <div class="Part-Header">
                    <h4>Huidige voorraad</h4>
                    <p>@part.Container.PartAmount stuks</p>
                </div>
                <div class="Part-Header">
                        <a class="btn btn-primary" asp-route-id="@part.Id" asp-page="/EditPages/EditParts">&#128393</a>
                </div>
            </div>
        </div>
        }
    }
    else
    {
        <h2>Sorry, maar ik heb geen relevante onderdelen gevonden.</h2>
    }
</div>

