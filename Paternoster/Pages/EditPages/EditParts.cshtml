@page
@using Paternoster.Models;
@model EditPartsModel
@{
    ViewData["Title"] = "Edit";
}

<h1>Wijzig @Model.Part.Name</h1>
<h4>Vul alstublieft zo veel mogelijk gegevens in. Invoervelden met een * zijn verplicht.</h4>
<hr />
<fieldset class="Edit-Form">
    <div class="Form-Fields">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

             <div class="form-group">
                <input hidden asp-for="Part.Id" class="form-control" aria-required="true" />
                <span asp-validation-for="Part.Id" class="text-danger"></span>
            </div>

            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Part.Name" class="control-label">Hoe heet dit onderdeel?</label>
                <input asp-for="Part.Name" class="form-control" aria-required="true" />
                <span asp-validation-for="Part.Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Part.PartCode" class="control-label">Welke code heeft dit onderdeel?</label>
                <input asp-for="Part.PartCode" class="form-control" aria-required="true" />
                <span asp-validation-for="Part.PartCode" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Part.ContainerId" class="control-label">In welke container gaat dit onderdeel?</label>
                <select asp-for="Part.ContainerId" class="form-control">
                    @foreach (PaternosterContainer paternosterContainer in Model.PaternosterContainers)
                    {
                        <option value="@paternosterContainer.Id">@paternosterContainer.ContainerCode</option>
                    }
                </select>
                <span asp-validation-for="Part.ContainerId" class="text-danger"></span>
            </div>

            <div>
                <a class="btn btn-primary" asp-area="" asp-page="./CreatePaternoster">Paternoster Toevoegen</a>
            </div>

            <div class="form-group">
                <label asp-for="Part.PartImage" class="control-label"></label>
                <input type="file" asp-for="Part.PartImage" class="form-control" />
                <span asp-validation-for="Part.PartImage" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Wijziging doorvoeren" class="btn btn-primary" />
            </div>
        </form>
    </div>
</fieldset>

<div>
    <a class="btn btn-primary" asp-route-id="@Model.Part.Id" asp-page="/FigurinePart">Terug naar 'Zoek Onderdeel'</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}