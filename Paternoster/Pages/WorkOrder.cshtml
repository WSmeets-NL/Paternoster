@page 
@model WorkOrderModel
@using Paternoster.Models


@{
    ViewData["Title"] = "Edit";
}

<h4>Order voor: @Model.Order.Customer.Name</h4>
<h4>Ordernummr: @Model.Order.OrderCode</h4>

<hr />

<h5>Producten in deze order:</h5>
<p>Gebruik de checkboxes om bij te houden welke producten gemonteerd zijn.</p>
<div class="order-products">
<ul class="workorder-list">
@foreach(OrderLine orderLine in Model.OrderLines)
        {
            <li class="workorder-product"><input type="checkbox" />@orderLine.ProductAmount X @orderLine.Product.Name</li>
        }
</ul>
</div>



<div class="order-completion">
    @if (Model.IsFinishable != false)
    {
        <div class="complete-order">
        <form method="post">
            <input hidden asp-for="Order.Id" />
            <input hidden asp-for="Order.OrderCode" />
            <div class="form-group">
                <input type="submit" value="Voltooi Order" class="btn btn-primary" />
            </div>
        </form>
    </div>
    }
    else
    {
        <div class="incomplete-order">
            <p>Sorry, maar van de volgende onderdelen is er niet genoeg op voorraad:</p>
            <ul class="workorder-list">
                @foreach(Part part in Model.MissingParts)
                {
                    <li class="workorder-part">@part.Name</li>
                }
            </ul>
            <p>Neem alstublieft contact op met de voorraadbeheerder.</p>
        </div>
    }
   
</div>

<div>
    <a class="btn btn-primary" asp-page="/Orders">Terug naar orders</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
